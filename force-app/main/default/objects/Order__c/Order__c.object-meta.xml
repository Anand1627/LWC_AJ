<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Order</label>
    <pluralLabel>Orders</pluralLabel>
    <nameField>
        <displayFormat>ORD-{00000}</displayFormat>
        <label>Order Number</label>
        <type>AutoNumber</type>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Custom object to manage customer orders</description>
    <fields>
        <fullName>Order_Number__c</fullName>
        <label>Order Number</label>
        <type>Text</type>
        <length>50</length>
        <unique>true</unique>
        <required>true</required>
    </fields>
    <fields>
        <fullName>Customer__c</fullName>
        <label>Customer</label>
        <type>Lookup</type>
        <referenceTo>Account</referenceTo>
        <relationshipName>Orders</relationshipName>
        <required>true</required>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Draft</fullName>
                    <default>true</default>
                    <label>Draft</label>
                </value>
                <value>
                    <fullName>Pending</fullName>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Confirmed</fullName>
                    <label>Confirmed</label>
                </value>
                <value>
                    <fullName>Processing</fullName>
                    <label>Processing</label>
                </value>
                <value>
                    <fullName>Shipped</fullName>
                    <label>Shipped</label>
                </value>
                <value>
                    <fullName>Delivered</fullName>
                    <label>Delivered</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <label>Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <required>true</required>
    </fields>
    <fields>
        <fullName>Total_Amount__c</fullName>
        <label>Total Amount</label>
        <type>Currency</type>
        <precision>18</precision>
        <scale>2</scale>
    </fields>
    <fields>
        <fullName>Order_Date__c</fullName>
        <label>Order Date</label>
        <type>Date</type>
        <required>true</required>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <label>Notes</label>
        <type>LongTextArea</type>
        <length>32768</length>
    </fields>
    <fields>
        <fullName>Shipping_Address__c</fullName>
        <label>Shipping Address</label>
        <type>LongTextArea</type>
        <length>32768</length>
    </fields>
    <fields>
        <fullName>Billing_Address__c</fullName>
        <label>Billing Address</label>
        <type>LongTextArea</type>
        <length>32768</length>
    </fields>
    <fields>
        <fullName>Priority__c</fullName>
        <label>Priority</label>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Low</fullName>
                    <default>true</default>
                    <label>Low</label>
                </value>
                <value>
                    <fullName>Medium</fullName>
                    <label>Medium</label>
                </value>
                <value>
                    <fullName>High</fullName>
                    <label>High</label>
                </value>
                <value>
                    <fullName>Urgent</fullName>
                    <label>Urgent</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Expected_Delivery_Date__c</fullName>
        <label>Expected Delivery Date</label>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Tracking_Number__c</fullName>
        <label>Tracking Number</label>
        <type>Text</type>
        <length>100</length>
    </fields>
</CustomObject>